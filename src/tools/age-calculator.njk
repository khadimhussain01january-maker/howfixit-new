<script>
function calcNiceDate(date){
  return date.toLocaleDateString(undefined,{year:"numeric",month:"long",day:"numeric"});
}
function calcDayName(date){
  return date.toLocaleDateString(undefined,{weekday:"long"});
}
function calcZodiac(month, day){
  const signs = [
    [20,"Capricorn"],[19,"Aquarius"],[21,"Pisces"],[20,"Aries"],[21,"Taurus"],[21,"Gemini"],
    [22,"Cancer"],[23,"Leo"],[23,"Virgo"],[23,"Libra"],[22,"Scorpio"],[22,"Sagittarius"],[21,"Capricorn"]
  ];
  return day < signs[month-1][0] ? signs[month-1][1] : signs[month][1];
}
function calculateAge(){
  const input = document.getElementById("calc-dob");
  const err = document.getElementById("calc-error");
  const result = document.getElementById("calc-result");
  err.textContent = "";
  result.classList.remove("show");
  if(!input.value){ err.textContent = "Please select your date of birth."; return; }

  const [yy, mm, dd] = input.value.split("-").map(Number);
  const birth = new Date(yy, mm-1, dd); birth.setHours(0,0,0,0);
  const today = new Date(); today.setHours(0,0,0,0);

  if(birth > today){ err.textContent = "Date of birth cannot be in the future."; return; }

  let y = today.getFullYear() - yy;
  let m = today.getMonth() - (mm - 1);
  let d = today.getDate() - dd;

  if(d < 0){
    m--;
    d += new Date(today.getFullYear(), today.getMonth(), 0).getDate();
  }
  if(m < 0){ y--; m += 12; }

  let next = new Date(today.getFullYear(), mm-1, dd);
  if(next < today) next = new Date(today.getFullYear()+1, mm-1, dd);
  const until = Math.ceil((next - today) / 86400000);

  const totalDays = Math.floor((today - birth) / 86400000);
  const totalWeeks = Math.floor(totalDays / 7);

  document.getElementById("calc-y").textContent = y.toLocaleString();
  document.getElementById("calc-m").textContent = m;
  document.getElementById("calc-d").textContent = d;
  document.getElementById("calc-age").textContent = `${y} Years, ${m} Months, ${d} Days`;
  document.getElementById("calc-born").textContent = `Born ${calcNiceDate(birth)}`;
  document.getElementById("calc-born-date").textContent = calcNiceDate(birth);
  document.getElementById("calc-born-day").textContent = `That was a ${calcDayName(birth)}.`;
  document.getElementById("calc-next").textContent = until === 0 ? "Happy Birthday! 🎉" : `${until.toLocaleString()} days`;
  document.getElementById("calc-next-date").textContent = calcNiceDate(next);
  document.getElementById("calc-zodiac").textContent = calcZodiac(mm, dd);
  document.getElementById("calc-total-days").textContent = totalDays.toLocaleString();
  document.getElementById("calc-total-weeks").textContent = `That's about ${totalWeeks.toLocaleString()} weeks.`;

  result.classList.add("show");
}
</script>
