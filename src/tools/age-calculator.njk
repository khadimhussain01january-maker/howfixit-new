    display:flex; align-items:center; justify-content:center;
    background: linear-gradient(150deg, #12203F, #1D3E99 65%, #2954C7);
  }
  :root[data-theme="dark"] .calc-visual, @media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .calc-visual{ background: linear-gradient(150deg,#0B1220,#152A5E 65%,#1D3E99); } }
