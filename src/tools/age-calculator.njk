    content:""; position:absolute; border-radius:50%; border:1px solid rgba(255,255,255,0.14);
  }
  .calc-visual::before{ width:340px; height:340px; animation: cv-spin 24s linear infinite; }
  .calc-visual::after{ width:260px; height:260px; animation: cv-spin 17s linear infinite reverse; }
  @keyframes cv-spin{ to{ transform: rotate(360deg); } }
  .cv-star{ position:absolute; width:3px; height:3px; border-radius:50%; background:#fff; opacity:.65; animation: cv-twinkle 2.6s ease-in-out infinite; }
  @keyframes cv-twinkle{ 50%{ opacity:.15; transform:scale(.5); } }

  .cv-clock{
    width:230px; height:230px; border-radius:50%; position:relative; z-index:2;
    background: radial-gradient(circle, #1D3E99 0 58%, #12203F 59% 100%);
    border:8px solid rgba(255,255,255,0.14);
    box-shadow: 0 0 0 10px rgba(255,255,255,0.03), 0 20px 50px rgba(0,0,0,0.3);
  }
  .cv-tick{ position:absolute; left:50%; top:50%; width:2px; height:10px; background:rgba(255,255,255,0.5); transform-origin:50% 105px; }
  .cv-hand{ position:absolute; left:50%; bottom:50%; transform-origin:50% 100%; border-radius:6px; background:#fff; }
  .cv-hour{ height:52px; width:5px; transform:translateX(-50%) rotate(35deg); }
  .cv-minute{ height:76px; width:4px; background:#AEC2F5; transform:translateX(-50%) rotate(125deg); }
  .cv-second{ height:86px; width:2px; background:#FF9F6E; transform:translateX(-50%) rotate(0deg); animation: cv-second 60s linear infinite; }
  @keyframes cv-second{ to{ transform:translateX(-50%) rotate(360deg); } }
  .cv-center{ position:absolute; width:10px; height:10px; border-radius:50%; background:#FF9F6E; left:50%; top:50%; transform:translate(-50%,-50%); }
  .calc-caption{ position:absolute; bottom:28px; text-align:center; color:#fff; z-index:3; }
  .calc-caption strong{ display:block; font-family: var(--font-serif); font-size:1.2rem; }
  .calc-caption span{ font-size:0.85rem; color:rgba(255,255,255,0.65); }

  /* Form side */
  .calc-form{ padding: 40px; }
  .calc-form label{ display:block; font-weight:600; font-size:0.95rem; margin-bottom:10px; }
  .calc-row{ display:flex; gap:10px; }
  .calc-form input[type="date"]{
    width:100%; height:52px; border:1px solid var(--border-strong); border-radius: var(--radius-sm);
    background: var(--bg); padding:0 14px; font-size:1rem; color: var(--text); font-family: var(--font-sans);
    outline:none; transition: border-color .15s ease;
  }
  .calc-form input[type="date"]:focus{ border-color: var(--accent); }
  .calc-error{ min-height:22px; padding-top:8px; color:#D33C5D; font-size:0.85rem; font-weight:600; }

  #calc-result{ display:none; }
  #calc-result.show{ display:block; animation: calc-appear .35s ease; }
  @keyframes calc-appear{ from{ opacity:0; transform:translateY(10px); } to{ opacity:1; transform:none; } }

  .calc-headline{
    margin-top:14px; border-radius: var(--radius-md); padding:22px; text-align:center; color:#fff;
    background: linear-gradient(135deg, #12203F, #2954C7);
  }
  .calc-headline .label{ font-size:0.72rem; letter-spacing:0.12em; text-transform:uppercase; opacity:.75; font-weight:700; }
  .calc-headline .value{ font-size:1.5rem; font-weight:800; margin:8px 0 4px; font-family: var(--font-serif); }
  .calc-headline .sub{ font-size:0.82rem; opacity:.7; }

  .calc-stats{ display:grid; grid-template-columns: repeat(3,1fr); gap:10px; margin-top:14px; }
  .calc-stat{ text-align:center; padding:16px 8px; border:1px solid var(--border); border-radius: var(--radius-md); background: var(--bg); }
  .calc-stat .num{ font-size:1.4rem; font-weight:800; color: var(--accent); font-family: var(--font-serif); }
  .calc-stat .name{ font-size:0.7rem; color: var(--text-muted); font-weight:700; margin-top:4px; letter-spacing:0.04em; }

  .calc-info-grid{ display:grid; grid-template-columns: 1fr 1fr; gap:10px; margin-top:14px; }
  .calc-info{ border:1px solid var(--border); border-radius: var(--radius-md); padding:18px; background: var(--bg); }
  .calc-info h3{ font-size:0.85rem; font-family: var(--font-sans); font-weight:700; margin:0 0 8px; }
  .calc-info .value{ font-size:1.15rem; font-weight:800; color: var(--accent); }
  .calc-info p{ font-size:0.78rem; color: var(--text-muted); margin:5px 0 0; line-height:1.5; }
  @media (max-width:560px){ .calc-info-grid{ grid-template-columns:1fr; } }

  .calc-privacy{ text-align:center; color: var(--text-muted); font-size:0.78rem; margin-top:16px; }
  @media (max-width:560px){ .calc-row{ flex-direction:column; } }
</style>

