---
layout: base.njk
title: Naveed AI Image Studio — HowFixIt
description: Turn a written description into an image, free, right in your browser. Add your own free Hugging Face key for sharper, high-quality results.
permalink: /tools/naveed-ai/
---
<style>
  .tool-hero{ padding: 56px 0 40px; }
  .tool-hero h1{ font-size: clamp(2rem, 3.8vw, 3rem); letter-spacing:-0.01em; }
  .tool-hero .lede{ margin-top:14px; font-size:1.1rem; color: var(--text-muted); max-width:56ch; }

  .tool-wrap{ padding: 0 0 72px; }

  .gen-panel{
    display:grid;
    grid-template-columns: 0.85fr 1.15fr;
    background: var(--surface);
    border:1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow:hidden;
    box-shadow: var(--shadow-card);
  }
  @media (max-width: 860px){ .gen-panel{ grid-template-columns: 1fr; } }

  /* Visual side */
  .gen-visual{
    position:relative; overflow:hidden;
    min-height: 420px;
    display:flex; align-items:center; justify-content:center;
    background: linear-gradient(150deg, #12203F, #1D3E99 65%, #2954C7);
  }
  :root[data-theme="dark"] .gen-visual{ background: linear-gradient(150deg,#0B1220,#152A5E 65%,#1D3E99); }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]) .gen-visual{ background: linear-gradient(150deg,#0B1220,#152A5E 65%,#1D3E99); }
  }
  .gen-visual::before, .gen-visual::after{
    content:""; position:absolute; border-radius:50%; border:1px solid rgba(255,255,255,0.14);
  }
  .gen-visual::before{ width:300px; height:300px; animation: gv-spin 22s linear infinite; }
  .gen-visual::after{ width:220px; height:220px; animation: gv-spin 15s linear infinite reverse; }
  @keyframes gv-spin{ to{ transform: rotate(360deg); } }
  .gv-star{ position:absolute; width:3px; height:3px; border-radius:50%; background:#fff; opacity:.65; animation: gv-twinkle 2.6s ease-in-out infinite; }
  @keyframes gv-twinkle{ 50%{ opacity:.15; transform:scale(.5); } }

  .gv-frame{
    width:190px; height:190px; position:relative; z-index:2;
    border:2px solid rgba(255,255,255,0.35);
    background: rgba(255,255,255,0.04);
  }
  .gv-frame::before{
    content:""; position:absolute; inset:-10px;
    border-radius:50%;
    background: conic-gradient(from 0deg, #FF9F6E, transparent 30%, transparent 70%, #FF9F6E);
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
    animation: gv-ring 3s linear infinite;
  }
  @keyframes gv-ring{ to{ transform: rotate(360deg); } }
  .gv-brush{
    position:absolute; left:14%; top:14%; width:72%; height:2px;
    background: linear-gradient(90deg, transparent, #AEC2F5, transparent);
    animation: gv-sweep 2.6s ease-in-out infinite;
  }
  @keyframes gv-sweep{ 0%,100%{ top:14%; opacity:0; } 10%{ opacity:1; } 50%{ top:86%; } 90%{ opacity:1; } }
  .calc-caption, .gen-caption{ position:absolute; bottom:28px; text-align:center; color:#fff; z-index:3; }
  .gen-caption strong{ display:block; font-family: var(--font-serif); font-size:1.2rem; }
  .gen-caption span{ font-size:0.85rem; color:rgba(255,255,255,0.65); }

  /* Form side */
  .gen-form{ padding: 40px; }
  .gen-form label{ display:block; font-weight:600; font-size:0.95rem; margin-bottom:10px; }
  .gen-form textarea{
    width:100%; min-height:88px; resize:vertical;
    border:1px solid var(--border-strong); border-radius: var(--radius-sm);
    background: var(--bg); padding:12px 14px; font-size:0.95rem; line-height:1.5;
    color: var(--text); font-family: var(--font-sans);
    outline:none; transition: border-color .15s ease;
  }
  .gen-form textarea:focus{ border-color: var(--accent); }

  .gen-controls{ display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
  .gen-select{
    appearance:none; -webkit-appearance:none;
    border:1px solid var(--border-strong); border-radius: var(--radius-sm);
    background: var(--bg); color: var(--text); padding:9px 28px 9px 12px;
    font-size:0.85rem; font-family: var(--font-sans); cursor:pointer;
    background-image:linear-gradient(45deg, transparent 50%, var(--text-muted) 50%), linear-gradient(135deg, var(--text-muted) 50%, transparent 50%);
    background-position: calc(100% - 14px) center, calc(100% - 9px) center;
    background-size: 5px 5px, 5px 5px; background-repeat:no-repeat;
  }
  .gen-select:focus{ border-color: var(--accent); outline:none; }
  .gen-btn-ghost{
    border:1px solid var(--border-strong); border-radius: var(--radius-sm);
    background: var(--bg); color: var(--text); padding:9px 14px;
    font-size:0.85rem; font-family: var(--font-sans); cursor:pointer;
    transition: border-color .15s ease, color .15s ease;
  }
  .gen-btn-ghost:hover{ border-color: var(--accent); color: var(--accent); }
  .gen-btn-ghost:disabled{ opacity:.45; cursor:not-allowed; }
  .gen-spacer{ flex:1 1 auto; }

  .gen-generate{
    height:52px; padding:0 26px; border:none; border-radius: var(--radius-sm);
    background: var(--accent); color:#fff; font-weight:700; font-size:0.95rem;
    font-family: var(--font-sans); cursor:pointer; margin-top:14px; width:100%;
    transition: filter .15s ease, transform .1s ease;
  }
  .gen-generate:hover{ filter:brightness(1.08); }
  .gen-generate:active{ transform: scale(0.99); }
  .gen-generate:disabled{ opacity:.55; cursor:not-allowed; }

  .gen-error{ min-height:20px; padding-top:8px; color:#D33C5D; font-size:0.85rem; font-weight:600; }

  /* Engine / settings */
  .gen-engine{
    display:inline-flex; align-items:center; gap:7px; margin-top:14px;
    border:1px solid var(--border); border-radius: var(--radius-sm);
    background: var(--bg); padding:6px 12px; font-size:0.78rem; color: var(--text-muted);
    cursor:pointer; user-select:none;
  }
  .gen-dot{ width:6px; height:6px; border-radius:50%; background: var(--text-muted); flex-shrink:0; }
  .gen-dot.on{ background:#2FA36B; box-shadow:0 0 5px #2FA36B; }
  .gen-dot.off{ background:#D33C5D; }

  .gen-settings{
    display:none; margin-top:12px; border:1px solid var(--border); border-radius: var(--radius-md);
    background: var(--bg); padding:16px;
  }
  .gen-settings.open{ display:block; }
  .gen-settings-row{ display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin-bottom:10px; }
  .gen-settings-row:last-of-type{ margin-bottom:0; }
  .gen-settings label.inline{ margin:0; font-size:0.8rem; min-width:70px; }
  .gen-key-wrap{ position:relative; flex:1 1 200px; }
  .gen-key-wrap input{
    width:100%; border:1px solid var(--border-strong); border-radius: var(--radius-sm);
    background: var(--surface); color: var(--text); padding:9px 62px 9px 12px;
    font-size:0.85rem; font-family: var(--font-sans);
  }
  .gen-key-toggle{
    position:absolute; right:6px; top:50%; transform:translateY(-50%);
    background:none; border:none; color: var(--text-muted); font-size:0.75rem; cursor:pointer;
  }
  .gen-settings a{ color: var(--accent); }
  .gen-settings-note{ font-size:0.75rem; color: var(--text-muted); line-height:1.55; margin-top:8px; }

  /* Result section below the panel */
  #gen-result{ display:none; margin-top:28px; }
  #gen-result.show{ display:block; animation: gen-appear .35s ease; }
  @keyframes gen-appear{ from{ opacity:0; transform:translateY(10px); } to{ opacity:1; transform:none; } }

  .gen-canvas-frame{
    position:relative; padding:12px;
    background: var(--surface); border:1px solid var(--border); border-radius: var(--radius-lg);
  }
  .gen-canvas-frame::before{
    content:""; position:absolute; inset:-1px; border-radius:inherit; z-index:-1; opacity:0;
    background: conic-gradient(from 0deg, var(--accent), transparent 25%, transparent 75%, var(--accent));
  }
  .gen-canvas-frame.generating::before{ opacity:1; animation: gen-rotate 2.2s linear infinite; }
  @keyframes gen-rotate{ to{ transform: rotate(360deg); } }

  .gen-canvas-inner{
    position:relative; overflow:hidden; border-radius: var(--radius-md);
    aspect-ratio: var(--ar, 1/1); background: var(--bg);
    display:flex; align-items:center; justify-content:center;
    border:1px solid var(--border);
  }
  .gen-canvas-inner img{
    width:100%; height:100%; object-fit:cover; display:block;
    opacity:0; transform:scale(1.03);
    transition: opacity .7s ease, transform .9s cubic-bezier(.2,.8,.2,1);
  }
  .gen-canvas-inner img.show{ opacity:1; transform:scale(1); }

  .gen-status{
    position:absolute; left:14px; bottom:14px; font-size:0.75rem; letter-spacing:0.03em;
    display:none; align-items:center; gap:7px; color: var(--accent);
  }
  .gen-status.active{ display:flex; }
  .gen-status-dot{ width:5px; height:5px; border-radius:50%; background: var(--accent); animation: gen-pulse 1s ease-in-out infinite; }
  @keyframes gen-pulse{ 0%,100%{ opacity:.3; } 50%{ opacity:1; } }

  .gen-meta{ display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap; margin-top:14px; }
  .gen-meta-text{ font-size:0.82rem; color: var(--text-muted); }
  .gen-actions{ display:flex; gap:8px; }

  .gen-history{ margin-top:20px; display:none; }
  .gen-history.show{ display:block; }
  .gen-history-label{ font-size:0.78rem; color: var(--text-muted); margin-bottom:8px; }
  .gen-history-row{ display:flex; gap:8px; overflow-x:auto; }
  .gen-hist-thumb{
    width:60px; height:60px; flex-shrink:0; object-fit:cover; cursor:pointer;
    border:1px solid var(--border); border-radius: var(--radius-sm);
    opacity:.7; filter:grayscale(0.3); transition: opacity .15s ease, filter .15s ease, border-color .15s ease;
  }
  .gen-hist-thumb:hover, .gen-hist-thumb.active{ opacity:1; filter:none; border-color: var(--accent); }

  .gen-privacy{ text-align:center; color: var(--text-muted); font-size:0.78rem; margin-top:16px; }

  @media (max-width:560px){ .gen-controls{ flex-direction:column; align-items:stretch; } }
</style>

<section class="tool-hero">
  <div class="wrap">
    <span class="eyebrow">Free Tool</span>
    <h1>Naveed AI Image Studio</h1>
    <p class="lede">Describe any picture in a sentence and watch it appear. Free to use — add your own free Hugging Face key for sharper, high-quality results.</p>
  </div>
</section>

<section class="tool-wrap">
  <div class="wrap">
    <div class="gen-panel">

      <div class="gen-visual" aria-hidden="true">
        <span class="gv-star" style="left:18%;top:18%;animation-delay:.2s"></span>
        <span class="gv-star" style="left:78%;top:23%;animation-delay:1s"></span>
        <span class="gv-star" style="left:15%;top:70%;animation-delay:1.7s"></span>
        <span class="gv-star" style="left:83%;top:72%;animation-delay:.7s"></span>
        <span class="gv-star" style="left:30%;top:12%;animation-delay:1.2s"></span>
        <span class="gv-star" style="left:69%;top:83%;animation-delay:2s"></span>

        <div class="gv-frame">
          <div class="gv-brush"></div>
        </div>
        <div class="gen-caption">
          <strong>Every idea, pictured.</strong>
          <span>Type it. Watch it take shape.</span>
        </div>
      </div>

      <div class="gen-form">
        <label for="gen-prompt">Describe the image</label>
        <textarea id="gen-prompt" placeholder="e.g. a mechanic's hands rewiring an old motorcycle, warm garage light, cinematic detail"></textarea>

        <div class="gen-controls">
          <select id="gen-style" class="gen-select">
            <option value="">No style</option>
            <option value="photorealistic, 85mm lens, natural light">Photorealistic</option>
            <option value="cinematic still, dramatic lighting, film grain">Cinematic</option>
            <option value="hand-drawn illustration, soft colors">Illustration</option>
            <option value="minimal 3d render, studio lighting, clay material">3D Render</option>
            <option value="watercolor painting, soft edges">Watercolor</option>
          </select>
          <select id="gen-ratio" class="gen-select">
            <option value="1024x1024" data-ar="1/1">Square</option>
            <option value="1024x1344" data-ar="3/4">Portrait</option>
            <option value="1344x1024" data-ar="4/3">Landscape</option>
            <option value="1536x864" data-ar="16/9">Widescreen</option>
          </select>
          <div class="gen-spacer"></div>
          <button type="button" class="gen-btn-ghost" id="gen-settings-toggle">Settings</button>
        </div>

        <div class="gen-engine" id="gen-engine-pill">
          <span class="gen-dot off" id="gen-engine-dot"></span>
          <span id="gen-engine-label">Free engine — add a key for higher quality</span>
        </div>

        <div class="gen-settings" id="gen-settings">
          <div class="gen-settings-row">
            <label class="inline" for="gen-hf-model">Model</label>
            <select id="gen-hf-model" class="gen-select" style="flex:1 1 200px;">
              <option value="black-forest-labs/FLUX.1-schnell">FLUX.1 Schnell — fast, sharp, great default</option>
              <option value="stabilityai/stable-diffusion-xl-base-1.0">Stable Diffusion XL — photoreal detail</option>
              <option value="playgroundai/playground-v2.5-1024px-aesthetic">Playground v2.5 — polished, aesthetic</option>
            </select>
          </div>
          <div class="gen-settings-row">
            <label class="inline" for="gen-hf-key">HF key</label>
            <div class="gen-key-wrap">
              <input type="password" id="gen-hf-key" placeholder="hf_xxxxxxxxxxxxxxxxxxxx" autocomplete="off">
              <button type="button" class="gen-key-toggle" id="gen-key-toggle">Show</button>
            </div>
            <button type="button" class="gen-btn-ghost" id="gen-save-key">Save</button>
            <button type="button" class="gen-btn-ghost" id="gen-clear-key">Remove</button>
          </div>
          <div class="gen-settings-note">
            Free at <a href="https://huggingface.co/settings/tokens" target="_blank" rel="noopener">huggingface.co/settings/tokens</a> — make an account, create a "Read" token, paste it above.
            It's saved only in your own browser and unlocks sharper, watermark-free images. Without a key the free fallback engine is used instead.
          </div>
        </div>

        <button type="button" class="gen-generate" id="gen-btn">Generate Image</button>
        <div id="gen-error" class="gen-error"></div>
      </div>

    </div>

    <div id="gen-result">
      <div class="gen-canvas-frame" id="gen-canvas-frame">
        <div class="gen-canvas-inner" id="gen-canvas-inner" style="--ar:1/1">
          <img id="gen-output-img" alt="Generated result">
          <div class="gen-status" id="gen-status"><span class="gen-status-dot"></span><span id="gen-status-text">painting…</span></div>
        </div>
      </div>
      <div class="gen-meta">
        <div class="gen-meta-text" id="gen-meta-text"></div>
        <div class="gen-actions">
          <button type="button" class="gen-btn-ghost" id="gen-regen-btn">New variation</button>
          <button type="button" class="gen-btn-ghost" id="gen-download-btn">Download</button>
        </div>
      </div>
      <div class="gen-history" id="gen-history">
        <div class="gen-history-label">Recent</div>
        <div class="gen-history-row" id="gen-history-row"></div>
      </div>
    </div>

    <div class="gen-privacy">🔒 Your prompts and API key stay in your browser — nothing is uploaded to HowFixIt's servers.</div>
  </div>
</section>

<script>
(function(){
  const promptEl = document.getElementById('gen-prompt');
  const styleEl = document.getElementById('gen-style');
  const ratioEl = document.getElementById('gen-ratio');
  const genBtn = document.getElementById('gen-btn');
  const regenBtn = document.getElementById('gen-regen-btn');
  const downloadBtn = document.getElementById('gen-download-btn');
  const outputImg = document.getElementById('gen-output-img');
  const resultBlock = document.getElementById('gen-result');
  const canvasFrame = document.getElementById('gen-canvas-frame');
  const canvasInner = document.getElementById('gen-canvas-inner');
  const genStatus = document.getElementById('gen-status');
  const genStatusText = document.getElementById('gen-status-text');
  const metaText = document.getElementById('gen-meta-text');
  const historyWrap = document.getElementById('gen-history');
  const historyRow = document.getElementById('gen-history-row');
  const errorEl = document.getElementById('gen-error');

  const settingsToggle = document.getElementById('gen-settings-toggle');
  const settingsPanel = document.getElementById('gen-settings');
  const hfKeyInput = document.getElementById('gen-hf-key');
  const hfModelSelect = document.getElementById('gen-hf-model');
  const keyToggle = document.getElementById('gen-key-toggle');
  const saveKeyBtn = document.getElementById('gen-save-key');
  const clearKeyBtn = document.getElementById('gen-clear-key');
  const enginePill = document.getElementById('gen-engine-pill');
  const engineDot = document.getElementById('gen-engine-dot');
  const engineLabel = document.getElementById('gen-engine-label');

  let history = [];
  let lastPrompt = '';

  const savedKey = localStorage.getItem('naveedai_hf_key') || '';
  const savedModel = localStorage.getItem('naveedai_hf_model');
  if(savedKey) hfKeyInput.value = savedKey;
  if(savedModel) hfModelSelect.value = savedModel;
  updateEngineStatus();

  settingsToggle.addEventListener('click', () => settingsPanel.classList.toggle('open'));
  enginePill.addEventListener('click', () => settingsPanel.classList.toggle('open'));

  keyToggle.addEventListener('click', () => {
    const showing = hfKeyInput.type === 'text';
    hfKeyInput.type = showing ? 'password' : 'text';
    keyToggle.textContent = showing ? 'Show' : 'Hide';
  });

  saveKeyBtn.addEventListener('click', () => {
    localStorage.setItem('naveedai_hf_key', hfKeyInput.value.trim());
    localStorage.setItem('naveedai_hf_model', hfModelSelect.value);
    updateEngineStatus();
    settingsPanel.classList.remove('open');
  });

  clearKeyBtn.addEventListener('click', () => {
    hfKeyInput.value = '';
    localStorage.removeItem('naveedai_hf_key');
    updateEngineStatus();
  });

  function updateEngineStatus(){
    const key = localStorage.getItem('naveedai_hf_key');
    if(key){
      engineDot.className = 'gen-dot on';
      engineLabel.textContent = 'Premium engine active (Hugging Face)';
    } else {
      engineDot.className = 'gen-dot off';
      engineLabel.textContent = 'Free engine — add a key for higher quality';
    }
  }

  function currentSize(){
    const parts = ratioEl.value.split('x');
    return { w: Number(parts[0]), h: Number(parts[1]) };
  }

  function pollinationsUrl(text, seed, w, h){
    const encoded = encodeURIComponent(text);
    return `https://image.pollinations.ai/prompt/${encoded}?width=${w}&height=${h}&seed=${seed}&model=flux&nologo=true&enhance=true`;
  }

  async function generateWithHF(text, model, token, w, h, attempt){
    attempt = attempt || 1;
    const res = await fetch(`https://api-inference.huggingface.co/models/${model}`, {
      method: 'POST',
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      body: JSON.stringify({ inputs: text, parameters: { width: w, height: h } })
    });

    if(res.ok){
      const blob = await res.blob();
      return URL.createObjectURL(blob);
    }

    let errData = null;
    try{ errData = await res.json(); }catch(e){}

    if(res.status === 503 && errData && errData.error && /loading/i.test(errData.error) && attempt < 4){
      const wait = Math.min(Math.ceil((errData.estimated_time || 15)) * 1000, 30000);
      genStatusText.textContent = `model warming up, retrying in ${Math.round(wait/1000)}s…`;
      await new Promise(r => setTimeout(r, wait));
      return generateWithHF(text, model, token, w, h, attempt + 1);
    }
    if(res.status === 401 || res.status === 403){
      throw new Error('That Hugging Face key was rejected — check it was copied in full and is a "Read" token.');
    }
    if(res.status === 429){
      throw new Error('Rate limit hit on the free tier — wait a minute and try again.');
    }
    throw new Error((errData && errData.error) || `Generation failed (status ${res.status}).`);
  }

  function setGenerating(isOn, label){
    genBtn.disabled = isOn;
    genBtn.textContent = isOn ? 'Painting…' : 'Generate Image';
    canvasFrame.classList.toggle('generating', isOn);
    genStatus.classList.toggle('active', isOn);
    if(isOn) genStatusText.textContent = label || 'painting…';
  }

  function showError(msg){ errorEl.textContent = msg; }
  function clearError(){ errorEl.textContent = ''; }

  async function runGeneration(rawPrompt, seed){
    if(!rawPrompt.trim()){ promptEl.focus(); return; }
    clearError();

    resultBlock.classList.add('show');
    const ar = ratioEl.options[ratioEl.selectedIndex].dataset.ar;
    canvasInner.style.setProperty('--ar', ar);
    const { w, h } = currentSize();
    const fullText = styleEl.value ? `${rawPrompt.trim()}, ${styleEl.value}` : rawPrompt.trim();
    const key = localStorage.getItem('naveedai_hf_key');
    const model = localStorage.getItem('naveedai_hf_model') || hfModelSelect.value;

    setGenerating(true, key ? 'painting with Hugging Face…' : 'painting…');
    outputImg.classList.remove('show');

    try{
      let url;
      if(key){
        url = await generateWithHF(fullText, model, key, w, h);
      } else {
        url = pollinationsUrl(fullText, seed, w, h);
        await new Promise((resolve, reject) => {
          const test = new Image();
          test.onload = resolve;
          test.onerror = () => reject(new Error('The free engine failed to respond — try again in a moment.'));
          test.src = url;
        });
      }
      outputImg.src = url;
      outputImg.classList.add('show');
      setGenerating(false);
      regenBtn.disabled = false;
      downloadBtn.disabled = false;
      metaText.textContent = `"${rawPrompt.trim()}"${key ? ' · Hugging Face' : ' · free engine'}`;
      history.unshift(url);
      history = history.slice(0, 8);
      renderHistory();
    }catch(err){
      setGenerating(false);
      showError(err.message || 'Something went wrong generating that image.');
    }
    lastPrompt = rawPrompt;
  }

  function renderHistory(){
    if(history.length === 0){ historyWrap.classList.remove('show'); return; }
    historyWrap.classList.add('show');
    historyRow.innerHTML = '';
    history.forEach((src, i) => {
      const t = document.createElement('img');
      t.className = 'gen-hist-thumb' + (i === 0 ? ' active' : '');
      t.src = src;
      t.addEventListener('click', () => {
        outputImg.src = src;
        outputImg.classList.add('show');
        downloadBtn.disabled = false;
        [...historyRow.children].forEach(c => c.classList.remove('active'));
        t.classList.add('active');
      });
      historyRow.appendChild(t);
    });
  }

  genBtn.addEventListener('click', () => runGeneration(promptEl.value, Math.floor(Math.random()*1e6)));
  promptEl.addEventListener('keydown', (e) => { if(e.key === 'Enter' && (e.metaKey || e.ctrlKey)) genBtn.click(); });
  regenBtn.addEventListener('click', () => runGeneration(lastPrompt || promptEl.value, Math.floor(Math.random()*1e6)));

  downloadBtn.addEventListener('click', async () => {
    try{
      const res = await fetch(outputImg.src);
      const blob = await res.blob();
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = `naveed-ai-${Date.now()}.jpg`;
      link.click();
    }catch(err){
      window.open(outputImg.src, '_blank');
    }
  });
})();
</script>
