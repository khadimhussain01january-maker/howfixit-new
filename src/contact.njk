  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Contact</span>
      <h1>Get in Touch</h1>
      <p class="lede">Have a question, a topic suggestion, or a services inquiry? Send us a message and we'll get back to you.</p>
      <div class="page-hero-photo" aria-hidden="true">
        <span class="thumb-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
        </span>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section aria-labelledby="contact-heading">
    <div class="wrap">
      <h2 id="contact-heading" class="visually-hidden">Contact form and details</h2>

      <div class="contact-grid">

        <form class="contact-form" aria-label="Contact form" action="mailto:hello@howfixit.com" method="post" enctype="text/plain">
          <div class="form-row-split">
            <div class="form-row">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" placeholder="Your name" required>
            </div>
            <div class="form-row">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" placeholder="you@example.com" required>
            </div>
          </div>

          <div class="form-row">
            <label for="reason">What's this about?</label>
            <select id="reason" name="reason">
              <option>General question</option>
              <option>Suggest a guide topic</option>
              <option>Services &amp; partnership inquiry</option>
              <option>Report an issue with a guide</option>
              <option>Something else</option>
            </select>
          </div>

          <div class="form-row">
            <label for="message">Message</label>
            <textarea id="message" name="message" placeholder="Tell us a bit about what you need…" required></textarea>
          </div>

          <button type="submit" class="btn btn-primary">Send Message</button>
          <p class="form-note">We read every message and reply as soon as we can, usually within a few business days.</p>
        </form>

        <div>
          <div class="info-card">
            <h3>Prefer email?</h3>
            <p>You can also reach us directly — this goes to the same place as the form above.</p>
            <a class="info-email" href="mailto:hello@howfixit.com">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
              hello@howfixit.com
            </a>
          </div>

          <div class="info-list">
            <div class="info-item">
              <div class="info-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 2l2.5 6.5L21 11l-6.5 2.5L12 20l-2.5-6.5L3 11l6.5-2.5z"/></svg>
              </div>
              <div>
                <h4>Have a guide idea?</h4>
                <p>Tell us the problem you'd like covered — helpful suggestions shape what we write next. See our <a href="/our-work/">published guides</a> first to check it isn't already up.</p>
              </div>
            </div>

            <div class="info-item">
              <div class="info-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="8" cy="8" r="3"/><circle cx="17" cy="16" r="3"/><path d="M10.5 9.5l4 5"/></svg>
              </div>
              <div>
                <h4>Brand or partnership?</h4>
                <p>Take a look at <a href="/services/">what we offer</a>, then reach out with a short summary of what you have in mind.</p>
              </div>
            </div>

            <div class="info-item">
              <div class="info-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 19V6a2 2 0 0 1 2-2h9l5 5v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><path d="M9 9h6M9 13h6M9 17h3"/></svg>
              </div>
              <div>
                <h4>Something wrong with a guide?</h4>
                <p>Let us know which guide and what you noticed, and we'll take a look.</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

